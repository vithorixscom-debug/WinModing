# Copy to .env locally. Never commit real values.
# These are runtime environment variables. They are not compiled into the .exe.

# Optional Azure public client. Leave empty to use the official Minecraft login window.
WINMODING_MS_CLIENT_ID=

# CurseForge Eternal API key. Prefer Settings → Catalog, which writes
# %LOCALAPPDATA%\WinModing\meta\curseforge.key
# Do not set this in CI: a compile-time key can be extracted from the binary.
WINMODING_CF_KEY=

# Discord Rich Presence. https:// image URL for large artwork, or a Discord
# application id you created (never Modrinth/Theseus ids). Empty application
# id uses Minecraft's Discord app so voice overlay is Minecraft, not a launcher.
# A copy of the WinModing mark is at docs/branding/discord-presence.png —
# host it (GitHub Releases or a raw file URL) and put that URL here after publish.
WINMODING_DISCORD_IMAGE=
WINMODING_DISCORD_CLIENT_ID=
WINMODING_DISCORD_ASSET=
