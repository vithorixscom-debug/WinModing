# Optional developer overrides. Users never need these.
# Copy to .env locally. Never commit real values.

# Official Minecraft Xbox client is used by default.
WINMODING_MS_CLIENT_ID=

# Optional CurseForge Eternal key if you want the official API instead of the public mirror.
WINMODING_CF_KEY=

# Optional Discord artwork URL / application id. Empty uses Minecraft's Discord app.
WINMODING_DISCORD_IMAGE=
WINMODING_DISCORD_CLIENT_ID=
WINMODING_DISCORD_ASSET=
